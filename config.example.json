{
  "data_dir": "{{CONTENT_PLATFORM_HOME}}/data",
  "generator": {
    "provider": "hermes-cli",
    "allow_fallback": false,
    "env_file": "{{CONTENT_PLATFORM_HOME}}/secrets/provider.env",
    "api_key_env": "OPENAI_API_KEY",
    "model": "",
    "hermes_command": "hermes",
    "hermes_provider": "",
    "hermes_model": "",
    "timeout": 180,
    "style_guide_path": "{{CONTENT_PLATFORM_HOME}}/skills/content/content-copywriting-style/SKILL.md"
  },
  "feature_flags": {
    "real_platform_trend_evidence_mode": "enforce",
    "topic_scoring_mode": "enforce",
    "quality_gate_enhanced": "enforce",
    "duplication_detector": "enforce",
    "run_contract": "enforce",
    "asset_ledger": "enforce",
    "viral_cover_gate": "enforce"
  },
  "workflow": {
    "require_gate_pass": true,
    "require_unified_acceptance": true
  },
  "resources": {
    "min_available_mb": 1200,
    "warning_disk_used_percent": 84,
    "max_disk_used_percent": 88,
    "video_max_disk_used_percent": 87
  },
  "risk": {
    "legacy_script": "{{CONTENT_PLATFORM_HOME}}/external/scripts/safe_filter.py",
    "timeout": 20
  },
  "media": {
    "image": {
      "enabled": true,
      "script": "{{CONTENT_PLATFORM_HOME}}/scripts/image_gen.py",
      "method": "auto",
      "provider": "auto",
      "model": "",
      "size": "1024x1024",
      "quality": "low",
      "timeout": 240
    },
    "video": {
      "enabled": true,
      "platforms": ["douyin", "bilibili", "youtube", "tiktok", "kuaishou", "shipinhao"],
      "script": "{{CONTENT_PLATFORM_HOME}}/external/scripts/video_pipeline.py",
      "visual_image_count": 8,
      "timeout": 600
    },
    "audio": {
      "enabled": false,
      "platforms": ["douyin", "bilibili", "youtube", "tiktok", "kuaishou", "shipinhao"],
      "mode": "auto",
      "timeout": 300
    }
  },
  "content_policy": {
    "original_content": "image_text_only",
    "short_video": "original_or_repurpose_by_ops_analysis",
    "allow_local_video_generation": true,
    "allow_local_audio_generation": true
  },
  "content_hygiene": {
    "enabled": true,
    "candidate_limit": 200,
    "block_threshold": 0.72,
    "review_threshold": 0.58
  },
  "ocr": {
    "script": "{{CONTENT_PLATFORM_HOME}}/external/scripts/ocr_pipeline.py",
    "timeout": 120
  },
  "transcription": {
    "script": "{{CONTENT_PLATFORM_HOME}}/external/scripts/transcribe_pipeline.py",
    "timeout": 300
  },
  "analysis": {
    "script": "{{CONTENT_PLATFORM_HOME}}/scripts/image_semantic_analyze.py",
    "timeout": 180,
    "required": true
  },
  "seo": {
    "openserp_host": "{{OPENSERP_HOST}}",
    "default_engine": "duck",
    "geo_checklist_enabled": true,
    "tools": ["openserp", "pyseoanalyzer"]
  },
  "delivery": {
    "max_attempts": 2,
    "backoff_seconds": 1,
    "auto_stage_review_required": true
  },
  "review": {
    "key_path": "{{CONTENT_PLATFORM_HOME}}/data/review.key",
    "token_ttl_seconds": 86400
  },
  "trends": {
    "legacy_data_dir": "{{CONTENT_PLATFORM_HOME}}/data/trend-cache",
    "legacy_script": "{{CONTENT_PLATFORM_HOME}}/external/scripts/trend_collector.py",
    "legacy_timeout": 20,
    "max_total_seconds": 45,
    "fallback_enabled": true,
    "direct_sources": {
      "hackernews": {
        "enabled": true,
        "limit": 20,
        "timeout": 8
      },
      "github": {
        "enabled": true,
        "limit": 20,
        "timeout": 8,
        "query": "AI workflow automation content operations"
      },
      "bilibili": {
        "enabled": true,
        "limit": 20,
        "timeout": 8
      },
      "wewrite_hotspots": {
        "enabled": false,
        "limit": 20,
        "timeout": 8,
        "wewrite_bin": "{{HOME}}/.local/bin/wewrite"
      }
    },
    "reddit": {
      "enabled": false,
      "client_id_env": "REDDIT_CLIENT_ID",
      "client_secret_env": "REDDIT_CLIENT_SECRET",
      "refresh_token_env": "REDDIT_REFRESH_TOKEN",
      "user_agent": "ai-self-media-tools/1.0.0 by configured-operator",
      "subreddits": ["SideProject", "ArtificialInteligence", "Entrepreneur"],
      "keywords": ["AI workflow", "automation", "content operations"],
      "limit_per_subreddit": 25,
      "sort": "hot",
      "time_filter": "week"
    }
  },
  "publishers": {
    "routing_defaults": {
      "enabled": true,
      "domestic": {
        "type": "manual-handoff",
        "reason": "domestic channels require an explicit policy-bounded platform route"
      },
      "international": {
        "type": "manual-handoff",
        "reason": "international auto publishing requires explicit per-platform cookie publisher"
      }
    },
    "platforms": {
      "kuaishou": {
        "type": "social-auto-upload",
        "account_name": "<account-alias>"
      },
      "wechat": {"type": "wechat-draft"},
      "weixin": {"type": "wechat-draft"},
      "wechat_official": {"type": "wechat-draft"},
      "zhihu": {"type": "zhihu-playwright", "account": "main", "save_as_draft": true},
      "juejin": {"type": "juejin-api", "account": "main", "save_as_draft": true},
      "twitter": {"type": "x-playwright", "account": "main"},
      "x": {"type": "x-playwright", "account": "main"},
      "bilibili": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "douyin": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "douyin_ai": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "douyin_pet": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "shipinhao": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "xiaohongshu": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "rednote": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "youtube": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "tiktok": {"type": "manual-handoff", "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"},
      "reddit": {
        "type": "reddit-draft",
        "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox",
        "default_subreddit": "manual-selection"
      }
    },
    "default": {
      "type": "file",
      "outbox": "{{CONTENT_PLATFORM_HOME}}/data/outbox"
    }
  },
  "notifications": {
    "log_path": "{{CONTENT_PLATFORM_HOME}}/data/notifications.jsonl",
    "network_enabled": true,
    "hermes_target_env": "AI_SELF_MEDIA_HERMES_TARGET"
  }
}
