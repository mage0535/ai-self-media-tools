[Unit]
Description=Run recoverable Hermes content-platform overnight batch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=CONTENT_PLATFORM_HOME=%h/.ai-self-media-tools
Environment=CONTENT_PLATFORM_BIN=%h/.local/bin/content-platform
EnvironmentFile=-%h/.ai-self-media-tools/secrets/proxy.env
EnvironmentFile=-%h/.ai-self-media-tools/secrets/notifications.env
# The private slots file selects only channels due tonight. It must not contain
# credentials and is deliberately separate from the public repository.
ExecStart=/bin/bash %h/.ai-self-media-tools/scripts/run_overnight_batch.sh
WorkingDirectory=%h/.ai-self-media-tools
MemoryMax=768M
TimeoutStartSec=17400
