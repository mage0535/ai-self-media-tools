[Unit]
Description=Remove rebuildable content-platform runtime intermediates
After=local-fs.target

[Service]
Type=oneshot
Environment=HOME=%h
ExecStart=/usr/bin/python3 %h/.ai-self-media-tools/scripts/cleanup_runtime_artifacts.py --data-dir %h/.ai-self-media-tools/data --retention-days 14 --apply
WorkingDirectory=%h/.ai-self-media-tools
MemoryMax=256M
