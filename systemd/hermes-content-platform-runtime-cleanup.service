[Unit]
Description=Remove rebuildable content-platform runtime intermediates
After=local-fs.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=CONTENT_PLATFORM_HOME=%h/.ai-self-media-tools-current
Environment=CONTENT_PLATFORM_CODE_ROOT=%h/.ai-self-media-tools-current
Environment=PYTHONPATH=%h/.ai-self-media-tools-current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CONTENT_PLATFORM_DATA_DIR=%h/.ai-self-media-tools/data
Environment=CONTENT_PLATFORM_SECRETS_DIR=%h/.ai-self-media-tools/secrets
Environment=CONTENT_PLATFORM_CONFIG=%h/.ai-self-media-tools/config.json
Environment=CONTENT_PLATFORM_RUNTIME_MODE=production
ExecStart=/usr/bin/python3 %h/.ai-self-media-tools-current/scripts/cleanup_runtime_artifacts.py --data-dir %h/.ai-self-media-tools/data --retention-days 14 --apply
WorkingDirectory=%h/.ai-self-media-tools-current
MemoryMax=256M
